{
  "name": "jev-devtools-workspace",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run build:package && npm run dev -w @jev-devtools/playground",
    "replay": "npm run build:package && node --import tsx scripts/replay-fixture.mjs",
    "build:package": "npm run build -w jev-devtools",
    "build": "npm run build:package && npm run build -w @jev-devtools/playground && npm run build:docs",
    "check": "npm run check:runtime && npm run check:release-records && node scripts/sync-readme-version.mjs --check && npm run build:package && npm run check --workspaces",
    "sync:readme-version": "node scripts/sync-readme-version.mjs",
    "test": "npm run build:package && npm test --workspaces && npm run test:release && npm run test:tooling && npm run test:release-tools",
    "test:release": "node --test scripts/release.test.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "check:playground": "node scripts/check-playground.mjs",
    "pack:devtools": "npm pack -w jev-devtools --pack-destination .",
    "verify:nextjs": "node scripts/verify-nextjs.mjs",
    "verify:drawer": "npm run build:package && node scripts/verify-drawer.mjs",
    "bench:server": "npm run build:package && node --expose-gc benchmarks/server.mjs",
    "bench:browser": "npm run build:package && node benchmarks/browser-server.mjs",
    "bench:compare": "node benchmarks/compare.mjs",
    "dev:docs": "npm run dev -w @jev-devtools/docs",
    "build:docs": "npm run build -w @jev-devtools/docs",
    "verify:docs": "npm run build:docs && npm run verify -w @jev-devtools/docs",
    "build:docs:publish": "npm run build:package && npm run build:publish -w @jev-devtools/docs",
    "preinstall": "node scripts/runtime.mjs",
    "check:runtime": "node scripts/runtime.mjs",
    "test:tooling": "node --test scripts/runtime.test.mjs scripts/verification-evidence.test.mjs scripts/cookbook-verification.test.mjs",
    "verify:flows": "npm run build:package && node scripts/run-flow-verification.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs",
    "verify:receipts": "node scripts/verify-all.mjs --receipts",
    "docs:publication": "node scripts/docs-publication.mjs",
    "test:release-tools": "node --test scripts/docs-publication.test.mjs scripts/receipt-scope.test.mjs",
    "check:release-records": "node scripts/receipt-scope.mjs",
    "verify:cookbooks": "npm run build:package && node scripts/run-cookbook-verification.mjs",
    "verify:evidence": "node scripts/check-verification-evidence.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.62.1",
    "prettier": "3.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "@shikijs/twoslash": {
      "typescript": "6.0.3"
    },
    "twoslash": {
      "typescript": "6.0.3"
    }
  }
}
