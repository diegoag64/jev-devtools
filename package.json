{
  "name": "jev-devtools-workspace",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run build:package && npm run dev -w @jev-devtools/playground",
    "build:package": "npm run build -w jev-devtools",
    "build": "npm run build:package && npm run build -w @jev-devtools/playground",
    "check": "node scripts/sync-readme-version.mjs --check && npm run build:package && npm run check --workspaces",
    "sync:readme-version": "node scripts/sync-readme-version.mjs",
    "test": "npm run build:package && npm test --workspaces && npm run test:release",
    "test:release": "node --test scripts/release.test.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "check:playground": "node scripts/check-playground.mjs",
    "pack:devtools": "npm pack -w jev-devtools --pack-destination .",
    "verify:nextjs": "node scripts/verify-nextjs.mjs",
    "verify:drawer": "npm run build:package && node scripts/verify-drawer.mjs",
    "bench:server": "npm run build:package && node --expose-gc benchmarks/server.mjs",
    "bench:browser": "npm run build:package && node benchmarks/browser-server.mjs",
    "bench:compare": "node benchmarks/compare.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.62.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
