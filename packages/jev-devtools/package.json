{
  "name": "jev-devtools",
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.22"
  },
  "description": "A React drawer and Node server adapter for inspecting TypeSafe Jev requests.",
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "import": "./lib/src/index.js"
    },
    "./server": {
      "types": "./lib/server/index.d.ts",
      "import": "./lib/server/index.js"
    },
    "./styles.css": "./lib/src/inspector.css",
    "./flow": {
      "types": "./lib/flow/index.d.ts",
      "import": "./lib/flow/index.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt",
    "skills"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "@typesafe-ai/sdk": ">=0.7.0 <0.8.0",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@typesafe-ai/sdk": "0.7.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegoag64/jev-devtools.git",
    "directory": "packages/jev-devtools"
  },
  "homepage": "https://github.com/diegoag64/jev-devtools#readme",
  "bugs": "https://github.com/diegoag64/jev-devtools/issues",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "tsc -p tsconfig.lib.json && node scripts/copy-styles.mjs",
    "prepack": "node ../../scripts/sync-readme-version.mjs --check && npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "jev",
    "typesafe",
    "devtools",
    "react",
    "nextjs",
    "inspector",
    "ai",
    "debugging"
  ]
}
